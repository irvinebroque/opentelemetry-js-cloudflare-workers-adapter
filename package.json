{
  "name": "opentelemetry-js-cloudflare-workers-adapter",
  "version": "0.1.4",
  "description": "A small OpenTelemetry API bridge to Cloudflare Workers native tracing.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "docs/compatibility.md",
    "test/README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "precheck": "npm run test:generate && cf workers types --mode test --include-runtime=false",
    "test": "vitest run",
    "dev": "vite",
    "prepack": "npm run build",
    "test:runtime": "npm run test:generate && npm run build && node --test --test-concurrency=1 test/runtime.test.mjs test/runtime-lifecycle.test.mjs",
    "verify": "npm run build && npm run check && npm test && node --test --test-concurrency=1 test/runtime.test.mjs test/runtime-lifecycle.test.mjs",
    "predev": "npm run build",
    "build:example": "npm run build && vite build",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:generate": "prisma generate --schema test/prisma/schema.prisma && node test/reload-fixture.mjs"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@ai-sdk/otel": "1.0.155",
    "@arizeai/openinference-instrumentation-langchain": "4.1.5",
    "@arizeai/openinference-instrumentation-openai": "4.4.2",
    "@aws-sdk/client-s3": "3.1158.0",
    "@azure/core-tracing": "1.4.0",
    "@azure/opentelemetry-instrumentation-azure-sdk": "1.0.0",
    "@braintrust/otel": "1.1.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.5",
    "@cloudflare/workers-types": "5.20261027.1",
    "@effect/opentelemetry": "4.0.6",
    "@fastify/otel": "0.21.4",
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/pubsub": "6.3.1",
    "@hono/otel": "1.3.0",
    "@langchain/core": "1.3.0",
    "@langfuse/tracing": "6.0.2",
    "@mastra/observability": "1.21.0",
    "@mastra/otel-exporter": "1.4.9",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-amqplib": "0.71.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.79.0",
    "@opentelemetry/instrumentation-fetch": "0.300.0",
    "@opentelemetry/instrumentation-graphql": "0.72.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-kafkajs": "0.33.0",
    "@opentelemetry/instrumentation-knex": "0.68.0",
    "@opentelemetry/instrumentation-mongodb": "0.77.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/instrumentation-redis": "0.72.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/instrumentation-winston": "0.69.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@sentry/cloudflare": "11.9.0",
    "@sveltejs/kit": "3.1.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "agents": "0.31.0",
    "ai": "^6.0.316",
    "ai-v7": "npm:ai@7.0.155",
    "amqplib": "2.2.0",
    "braintrust": "3.40.0",
    "bullmq": "6.5.0",
    "bullmq-otel": "2.0.1",
    "cf": "^1.0.0-beta.23",
    "effect": "4.0.6",
    "fastify": "5.12.7",
    "graphql": "16.14.2",
    "hono": "4.13.14",
    "inngest": "4.26.1",
    "ioredis": "6.0.0",
    "kafkajs": "2.2.4",
    "knex": "3.3.0",
    "langsmith": "0.11.3",
    "mongodb": "7.7.0",
    "next": "16.4.3",
    "openai": "7.45.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "redis": "6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "winston": "3.19.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "typescript": "$typescript"
    },
    "@opentelemetry/api": "$@opentelemetry/api"
  }
}
